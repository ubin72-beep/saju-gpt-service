{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/**/*.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/send-daily-fortune.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
