<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>관리자 로그인 (임시) - AI 사주 천년지기</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 450px;
            overflow: hidden;
        }

        .login-header {
            background: linear-gradient(135deg, #c41e3a 0%, #a01830 100%);
            padding: 3rem 2rem;
            text-align: center;
            color: white;
        }

        .login-header i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .login-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .login-header p {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .temp-notice {
            background: #fff3cd;
            color: #856404;
            padding: 1rem;
            border-left: 4px solid #ffc107;
            margin: 1rem 2rem;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        .temp-notice strong {
            display: block;
            margin-bottom: 0.5rem;
        }

        .login-body {
            padding: 2.5rem 2rem;
        }

        .alert {
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            display: none;
        }

        .alert.show {
            display: block;
        }

        .alert-danger {
            background: #fee;
            color: #c00;
            border: 1px solid #fcc;
        }

        .alert-success {
            background: #dfd;
            color: #060;
            border: 1px solid #afa;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #333;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
        }

        .form-control {
            width: 100%;
            padding: 1rem 1rem 1rem 3rem;
            border: 2px solid #ddd;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: #c41e3a;
            box-shadow: 0 0 0 4px rgba(196,30,58,0.1);
        }

        .btn-login {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #c41e3a 0%, #a01830 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(196,30,58,0.3);
        }

        .login-footer {
            text-align: center;
            padding: 1.5rem;
            background: #f9f9f9;
            border-top: 1px solid #eee;
        }

        .login-footer a {
            color: #c41e3a;
            text-decoration: none;
            font-weight: 500;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }

        .credentials {
            background: #e7f3ff;
            border: 1px solid #90caf9;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .credentials h3 {
            color: #1976d2;
            margin-bottom: 1rem;
            font-size: 1rem;
        }

        .credentials .item {
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }

        .credentials .item strong {
            min-width: 80px;
            color: #333;
        }

        .credentials .item span {
            color: #666;
            font-family: monospace;
            background: white;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <i class="fas fa-shield-alt"></i>
            <h1>관리자 로그인 (임시)</h1>
            <p>AI 사주 천년지기 관리 시스템</p>
        </div>

        <div class="temp-notice">
            <strong>⚠️ 임시 로그인 페이지</strong>
            백엔드 서버가 배포되지 않아 LocalStorage 기반 인증을 사용합니다.<br>
            실제 서비스에서는 보안이 강화된 백엔드 인증으로 전환됩니다.
        </div>

        <div class="login-body">
            <div id="alertBox" class="alert"></div>

            <div class="credentials">
                <h3><i class="fas fa-key"></i> 기본 관리자 계정</h3>
                <div class="item">
                    <strong>아이디:</strong>
                    <span>admin</span>
                </div>
                <div class="item">
                    <strong>비밀번호:</strong>
                    <span>admin1234</span>
                </div>
            </div>

            <form id="loginForm">
                <div class="form-group">
                    <label>아이디</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user"></i>
                        <input type="text" id="username" class="form-control" value="admin" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>비밀번호</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="password" class="form-control" value="admin1234" required>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="submitBtn">
                    로그인 <i class="fas fa-arrow-right"></i>
                </button>
            </form>
        </div>

        <div class="login-footer">
            <a href="index.html">
                <i class="fas fa-arrow-left"></i> 메인 사이트로 돌아가기
            </a>
        </div>
    </div>

    <script src="js/admin-auth.js"></script>
    <script>
        const form = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const alertBox = document.getElementById('alertBox');

        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            if (!username || !password) {
                showAlert('아이디와 비밀번호를 입력해주세요.', 'danger');
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner"></span> 로그인 중...';

            // admin-auth.js의 adminLogin 함수 사용
            const result = adminLogin(username, password);

            if (result.success) {
                showAlert('✅ 로그인 성공! 관리자 페이지로 이동합니다...', 'success');
                
                setTimeout(() => {
                    window.location.href = 'admin.html';
                }, 1000);
            } else {
                showAlert('❌ ' + result.message, 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '로그인 <i class="fas fa-arrow-right"></i>';
            }
        });

        function showAlert(message, type) {
            alertBox.className = 'alert alert-' + type + ' show';
            alertBox.innerHTML = '<i class="fas fa-' + (type === 'success' ? 'check' : 'exclamation') + '-circle"></i> ' + message;
        }

        // 이미 로그인된 경우 자동 리다이렉트
        if (isAdminLoggedIn()) {
            showAlert('✅ 이미 로그인되어 있습니다. 리다이렉트 중...', 'success');
            setTimeout(() => {
                window.location.href = 'admin.html';
            }, 1000);
        }
    </script>
</body>
</html>
